if not game:IsLoaded() then game.Loaded:Wait() end
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RS = game:GetService("ReplicatedStorage")

-- Khai báo an toàn các Module bằng pcall
local Modules = RS:WaitForChild("Modules", 10)
local TycoonModule, ClientTycoonBalances, ClientTycoonRebirth, ClientTycoonEvolution, Huge

if Modules then
    pcall(function() TycoonModule = require(Modules:WaitForChild("Tycoon"):WaitForChild("Tycoon")) end)
    pcall(function() Huge = require(Modules:WaitForChild("Huge")) end)
    
    local TycoonFolder = Modules:FindFirstChild("Tycoon")
    local ComponentFolder = TycoonFolder and TycoonFolder:FindFirstChild("Component")
    local ClientFolder = ComponentFolder and ComponentFolder:FindFirstChild("Client")
    
    if ClientFolder then
        pcall(function() ClientTycoonBalances = require(ClientFolder:WaitForChild("ClientTycoonBalances", 5)) end)
        pcall(function() ClientTycoonRebirth = require(ClientFolder:WaitForChild("ClientTycoonRebirth", 5)) end)
        pcall(function() ClientTycoonEvolution = require(ClientFolder:WaitForChild("ClientTycoonEvolution", 5)) end)
    end
end

local function getTycoon()
    if TycoonModule and TycoonModule.getLocal then
        local ok, result = pcall(TycoonModule.getLocal)
        if ok then return result end
    end
    return nil
end

