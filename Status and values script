-- ========================================================
-- 2. HÀM CUSTOM ĐỂ NẠP / CẬP NHẬT CÁC DÒNG VALUES
-- ========================================================
_G.updateValue = function(infoName, infoValue, customColor)
    local rowName = infoName .. "_Row"
    local row = MainFrame:FindFirstChild(rowName)
    
    if not row then
        row = Instance.new("Frame")
        row.Name = rowName
        row.Size = UDim2.new(1, 0, 0, 22)
        row.BackgroundTransparency = 1
        row.LayoutOrder = #MainFrame:GetChildren()
        
        local leftLabel = Instance.new("TextLabel")
        leftLabel.Size = UDim2.new(0.6, 0, 1, 0)
        leftLabel.Position = UDim2.new(0, 10, 0, 0)
        leftLabel.BackgroundTransparency = 1
        leftLabel.Text = infoName .. ":"
        leftLabel.TextColor3 = Color3.fromRGB(180, 180, 180) 
        leftLabel.TextSize = 13
        leftLabel.Font = Enum.Font.SourceSans
        leftLabel.TextXAlignment = Enum.TextXAlignment.Left
        leftLabel.Parent = row
        
        local rightLabel = Instance.new("TextLabel")
        rightLabel.Name = "ValueLabel"
        rightLabel.Size = UDim2.new(0.4, -10, 1, 0)
        rightLabel.Position = UDim2.new(0.6, 0, 0, 0)
        rightLabel.BackgroundTransparency = 1
        rightLabel.Text = tostring(infoValue)
        rightLabel.TextColor3 = customColor or Color3.fromRGB(255, 255, 255) 
        rightLabel.TextSize = 13
        rightLabel.Font = Enum.Font.SourceSansBold
        rightLabel.TextXAlignment = Enum.TextXAlignment.Right
        rightLabel.Parent = row
        
        row.Parent = MainFrame
        MainFrame.Size = UDim2.new(0, 240, 0, #MainFrame:GetChildren() * 24)
    else
        local rightLabel = row:FindFirstChild("ValueLabel")
        if rightLabel then
            rightLabel.Text = tostring(infoValue)
            if customColor then
                rightLabel.TextColor3 = customColor
            end
        end
    end
end

