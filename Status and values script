-- Hàm cập nhật/hiển thị dữ liệu nội bộ mượt mà
local function safeUpdateValue(infoName, infoValue, customColor)
    local rowName = infoName:gsub("%s+", "") .. "_Row"
    local row = MainFrame:FindFirstChild(rowName)
    
    if not row then
        row = Instance.new("Frame")
        row.Name = rowName
        row.Size = UDim2.new(1, 0, 0, 22)
        row.BackgroundTransparency = 1
        row.LayoutOrder = #MainFrame:GetChildren() + 1
        
        local leftLabel = Instance.new("TextLabel")
        leftLabel.Size = UDim2.new(0.6, 0, 1, 0)
        leftLabel.Position = UDim2.new(0, 10, 0, 0)
        leftLabel.BackgroundTransparency = 1
        leftLabel.Text = infoName .. ":"
        leftLabel.TextColor3 = Color3.fromRGB(180, 180, 180) 
        leftLabel.TextSize = 13
        leftLabel.Font = Enum.Font.SourceSans
        leftLabel.TextXAlignment = Enum.TextXAlignment.Left
        leftLabel.Parent = row
        
        local rightLabel = Instance.new("TextLabel")
        rightLabel.Name = "ValueLabel"
        rightLabel.Size = UDim2.new(0.4, -15, 1, 0)
        rightLabel.Position = UDim2.new(0.6, 0, 0, 0)
        rightLabel.BackgroundTransparency = 1
        rightLabel.Text = tostring(infoValue)
        rightLabel.TextColor3 = customColor or Color3.fromRGB(255, 255, 255) 
        rightLabel.TextSize = 13
        rightLabel.Font = Enum.Font.SourceSansBold
        rightLabel.TextXAlignment = Enum.TextXAlignment.Right
        rightLabel.Parent = row
        
        row.Parent = MainFrame
    else
        local rightLabel = row:FindFirstChild("ValueLabel")
        if rightLabel then
            rightLabel.Text = tostring(infoValue)
            if customColor then rightLabel.TextColor3 = customColor end
        end
    end
end

-- ========================================================
-- VÒNG LẶP QUÉT CHỈ SỐ AN TOÀN
-- ========================================================
task.spawn(function()
    while StatusGui and StatusGui.Parent do
        local t = getTycoon()
        if t then
            local oldStatus = MainFrame:FindFirstChild("Status_Row")
            if oldStatus then oldStatus:Destroy() end

            pcall(function()
                -- 1. Tiền (Cash) & Nhà đầu tư (Investors)
                if ClientTycoonBalances then
                    local bal = t:GetComponent(ClientTycoonBalances)
                    if bal then
                        local cashVal = bal:GetCash() or 0
                        local invVal = bal:GetInvestors() or 0
                        
                        if Huge and Huge.formatShort then
                            safeUpdateValue("Estimated Current Cash", Huge.formatShort(cashVal), Color3.fromRGB(0, 255, 120))
                            safeUpdateValue("Current Total Investors", Huge.formatShort(invVal), Color3.fromRGB(0, 210, 255))
                        else
                            safeUpdateValue("Estimated Current Cash", tostring(cashVal), Color3.fromRGB(0, 255, 120))
                            safeUpdateValue("Current Total Investors", tostring(invVal), Color3.fromRGB(0, 210, 255))
                        end
                    end
                end
                
                -- 2. Dữ liệu Rebirth
                if ClientTycoonRebirth then
                    local rb = t:GetComponent(ClientTycoonRebirth)
                    if rb then
                        local rbCount = rb:GetRebirths() or 0
                        safeUpdateValue("Current Rebirths", tostring(rbCount), Color3.fromRGB(230, 100, 255))
                    end
                end
                
                -- 3. Tiến trình Tiến hóa (Evolution)
                if ClientTycoonEvolution then
                    local ev = t:GetComponent(ClientTycoonEvolution)
                    if ev then
                        local progress = ev:GetEvolutionProgress() or 0
                        local formattedPercent = string.format("%.0f%%", math.clamp(progress * 100, 0, 100))
                        safeUpdateValue("Evolution Progress", formattedPercent, Color3.fromRGB(255, 100, 100))
                    end
                end
            end)
        else
            safeUpdateValue("Status", "Waiting for Tycoon...", Color3.fromRGB(255, 150, 0))
        end
        
        -- Các chỉ số thuộc tính phụ
        pcall(function()
            local valuesFolder = LocalPlayer:FindFirstChild("Values")
            if valuesFolder then
                local function addAttr(name, label)
                    local v = valuesFolder:GetAttribute(name)
                    if v ~= nil then safeUpdateValue(label, tostring(v), Color3.fromRGB(255, 200, 50)) end
                end
                addAttr("CashDropsPickedUp", "Cash Drops Picked Up")
                addAttr("FruitsClicked", "Fruits Clicked")
                addAttr("MinigameRacePlayed", "Minigame Race Played")
            end
        end)

        task.wait(0.5)
    end
end)

-- Phím tắt ẩn hiện menu L an toàn
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.L then
        task.defer(function()
            if StatusGui then
                StatusGui.Enabled = not StatusGui.Enabled
            end
        end)
    end
end)
