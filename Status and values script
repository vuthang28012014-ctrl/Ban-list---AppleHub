-- Hàm ép mở máy Investors qua ProximityPrompt
local function forceLoadInvestors()
    pcall(function()
        local prompt = workspace:FindFirstChild("Tycoon3")
            and workspace.Tycoon3:FindFirstChild("Rebirth")
            and workspace.Tycoon3.Rebirth:FindFirstChild("Investors")
            and workspace.Tycoon3.Rebirth.Investors:FindFirstChild("Alien")
            and workspace.Tycoon3.Rebirth.Investors.Alien:FindFirstChild("HumanoidRootPart")
            and workspace.Tycoon3.Rebirth.Investors.Alien.HumanoidRootPart:FindFirstChild("MenuPrompt")

        if prompt and fireproximityprompt then
            fireproximityprompt(prompt) 
            task.wait(0.3) 
            
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            local menu = pGui and pGui:FindFirstChild("Rebirth") and pGui.Rebirth:FindFirstChild("InvestorsMenu")
            if menu then
                menu.Visible = false 
            end
        end
    end)
end

-- Khởi tạo giá trị ban đầu cho các chỉ số để khung UI không bị trống khi mới bật script
local valuesFolder = LocalPlayer:WaitForChild("Values", 10)
if valuesFolder then
    local function updateAllAttributes()
        local function checkAttr(name)
            local val = valuesFolder:GetAttribute(name)
            return val ~= nil and tostring(val) or nil
        end
        
        -- Chỉ cập nhật lên UI nếu giá trị lấy ra thực sự khác nil (tránh bị đè số 0 lỗi)
        if checkAttr("CashDropsPickedUp") then _G.updateValue("Cash Drops Picked Up", checkAttr("CashDropsPickedUp"), Color3.fromRGB(255, 200, 50)) end
        if checkAttr("CashVineAvailable") then _G.updateValue("Cash Vine Available", checkAttr("CashVineAvailable"), Color3.fromRGB(255, 200, 50)) end
        if checkAttr("CashVineUses") then _G.updateValue("Cash Vine Uses", checkAttr("CashVineUses"), Color3.fromRGB(255, 200, 50)) end
        if checkAttr("FruitsClicked") then _G.updateValue("Fruits Clicked", checkAttr("FruitsClicked"), Color3.fromRGB(255, 200, 50)) end
        if checkAttr("MinigameRacePlayed") then _G.updateValue("Minigame Race Played", checkAttr("MinigameRacePlayed"), Color3.fromRGB(255, 200, 50)) end
        if checkAttr("VoidEvents") then _G.updateValue("Void Events", checkAttr("VoidEvents"), Color3.fromRGB(255, 200, 50)) end
    end

    -- Chạy nạp chữ lần đầu tiên
    updateAllAttributes()

    -- Bắt sự kiện: Bất kỳ chỉ số nào trong folder thay đổi thì lập tức cập nhật, không dùng vòng lặp quét mò nữa
    valuesFolder.AttributeChanged:Connect(function(attributeName)
        local val = valuesFolder:GetAttribute(attributeName)
        if val ~= nil then
            if attributeName == "CashDropsPickedUp" then _G.updateValue("Cash Drops Picked Up", tostring(val), Color3.fromRGB(255, 200, 50))
            elseif attributeName == "CashVineAvailable" then _G.updateValue("Cash Vine Available", tostring(val), Color3.fromRGB(255, 200, 50))
            elseif attributeName == "CashVineUses" then _G.updateValue("Cash Vine Uses", tostring(val), Color3.fromRGB(255, 200, 50))
            elseif attributeName == "FruitsClicked" then _G.updateValue("Fruits Clicked", tostring(val), Color3.fromRGB(255, 200, 50))
            elseif attributeName == "MinigameRacePlayed" then _G.updateValue("Minigame Race Played", tostring(val), Color3.fromRGB(255, 200, 50))
            elseif attributeName == "VoidEvents" then _G.updateValue("Void Events", tostring(val), Color3.fromRGB(255, 200, 50))
            end
        end
    end)
end

-- Vòng lặp chạy riêng cho Cash và Investors (Vì 2 cái này nằm ở Leaderstats và PlayerGui)
task.spawn(function()
    while true do
        -- Đồng bộ Cash
        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        local cashObj = leaderstats and leaderstats:FindFirstChild("Cash")
        if cashObj then
            _G.updateValue("Estimated Current Cash", cashObj.Value, Color3.fromRGB(0, 255, 120))
        end
        
        -- Đồng bộ Investors
        local investorText = nil
        pcall(function()
            local quantityObj = LocalPlayer.PlayerGui.Rebirth.InvestorsMenu.Body.Amount.Quantity
            if quantityObj and quantityObj.Text ~= "" and quantityObj.Text ~= "0" then
                investorText = quantityObj.Text
            end
        end)
        
        if investorText then
            _G.updateValue("Current Total Investors", investorText, Color3.fromRGB(0, 210, 255))
        else
            _G.updateValue("Current Total Investors", "Loading...", Color3.fromRGB(255, 150, 0))
            forceLoadInvestors()
        end
        
        task.wait(1) -- Giảm tải xuống 1 giây quét 1 lần cho nhẹ máy
    end
end)

